{
  "name": "mavro-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "brand": "node scripts/brand.mjs",
    "clients": "node scripts/clients.mjs",
    "linkcheck": "node scripts/linkcheck.cjs dist"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.35.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
